package com.krakedev;

public class TestCalculadora {

	public static void main(String[] args) {
		//defino la variable
		Calculadora calcu;
		//asigno objeto 
		calcu = new Calculadora();
		int resultadoSuma;
		double resultadoResta;
		double resultadoMultiplicacion, resultadoDividir, resultadoPromedio;
		
		resultadoSuma=calcu.sumar(5, 3);
		System.out.println("RESULTADO SUMA: "+resultadoSuma);
		
		resultadoResta=calcu.restar(8, 10);
		System.out.println("RESULTADO RESTA: "+resultadoResta);
		
		resultadoMultiplicacion=calcu.multiplicar(10, 5);
		resultadoDividir=calcu.dividir(10,2);
		resultadoPromedio=calcu.promedio(10, 8,9);
	}

}
