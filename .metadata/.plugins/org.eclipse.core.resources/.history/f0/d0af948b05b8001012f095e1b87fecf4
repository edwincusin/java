package com.krakedev;

public class Rectangulo {
	public int base;
	public int altura;
		
	public int calcularArea() {
		int area=base*altura;
		return area;		
	}
		
	//INICIO RETO 10
	//calcular perimetro de un rectangulo
	public int calcularPerimetro() {
		int perimetro=(calcularArea())*2;
		return perimetro;
	}
	
	
	
	
	
}
