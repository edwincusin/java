package com.krakedev;

public class Cuadrado {
	public double lado;
	
	//metodo calcular area
	public double calcularArea(){
		double area = Math.pow(lado, 2);
		return area;
	}
	
	//metodo calcular perimetro
		public double calcularPerimetro(){
			double perimetro = lado*4;
			return perimetro;
		}
	
}
